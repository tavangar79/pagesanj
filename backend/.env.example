# Copy to .env and fill in. Never commit real values (PRD §12).

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000
CONTACT_EMAIL=

# Data
MONGODB_URI=mongodb://localhost:27017/pagesanj
# Must use maxmemory-policy noeviction (BullMQ requirement)
REDIS_URL=redis://localhost:6379

# Meta / Instagram (§10)
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
IG_ACCESS_TOKEN=
IG_ACCOUNT_ID=
GRAPH_API_VERSION=v23.0

# Apify (§6.2)
APIFY_TOKEN=
APIFY_BUDGET_STOP_USD=4.50
DAILY_CHECK_CRON=0 9 * * *

# Admin auth (§9.1)
SESSION_SECRET=
# Same value as trust-me's (base64 of 32 bytes)
DATA_ENCRYPTION_KEY=
# Optional, read-only; only for npm run admin:import
TRUSTME_MONGODB_URI=
# Only for npm run admin:create
ADMIN_PASSWORD=
